<Window x:Class="LcdWidget.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="机核仪表 · 设置" Width="1040" Height="780" MinWidth="740" MinHeight="560" Background="#101923" Foreground="#E1EBEF" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#263B4B"/><Setter Property="Foreground" Value="#EDF7F9"/><Setter Property="BorderBrush" Value="#466072"/><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,3,8,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#35586B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#80E1E8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E1EBEF"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#192938"/><Setter Property="Foreground" Value="#F0F5F7"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#466072"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,3,8,3"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#142330"/><Setter Property="MinWidth" Value="130"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="0,3,10,3"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#142330"/></Style>
  <Style TargetType="TabItem"><Setter Property="Background" Value="#203343"/><Setter Property="Foreground" Value="#91DDE3"/><Setter Property="Padding" Value="18,9"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#152532"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#14212C"/><Setter Property="Foreground" Value="#E1EBEF"/><Setter Property="RowBackground" Value="#14212C"/><Setter Property="AlternatingRowBackground" Value="#192B38"/><Setter Property="BorderBrush" Value="#314A5C"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="32"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#263D4F"/><Setter Property="Foreground" Value="#DFEDF0"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5,0"/></Style>
 </Window.Resources>
 <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
 <Grid x:Name="PageLayout" Margin="20" Height="660" Width="950" Background="#101923">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10"><Image x:Name="BrandIcon" Width="38" Height="38" Margin="0,0,12,0"/><StackPanel><TextBlock Text="机核仪表" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="设置即时生效并保存 · 关闭此窗口不退出小组件" Foreground="#95AEBE"/></StackPanel></DockPanel>
  <TextBlock x:Name="EnvironmentText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10"/>
  <TabControl x:Name="Tabs" Grid.Row="2" Background="#101923" BorderBrush="#314A5C">
   <TabItem Header="显示与外观"><Grid Margin="12" TextElement.Foreground="#E1EBEF">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <WrapPanel><TextBlock Text="皮肤  "/><ComboBox x:Name="SkinBox" DisplayMemberPath="Name" SelectedValuePath="Id"/><TextBlock Text="尺寸  "/><ComboBox x:Name="SizeBox"/><CheckBox x:Name="TopmostBox" Content="始终置顶"/><Button x:Name="StartupButton" Content="自启动：读取中…"/></WrapPanel>
    <WrapPanel Grid.Row="1"><TextBlock Text="GPU  "/><ComboBox x:Name="GpuBox" Width="250" DisplayMemberPath="Name" SelectedValuePath="Id"/><TextBlock Text="磁盘  "/><ComboBox x:Name="DiskBox" Width="200" DisplayMemberPath="Name" SelectedValuePath="Id"/></WrapPanel>
    <Grid Grid.Row="2" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition/></Grid.ColumnDefinitions><UniformGrid x:Name="Slots" Columns="2" Rows="4"/><StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="SlotHeading" TextWrapping="Wrap" FontSize="16"/><TextBlock Text="先点击位置，再选择下方指标。允许多个位置选择同一指标。" TextWrapping="Wrap" Margin="0,8"/><Button x:Name="ResetButton" Content="恢复默认显示指标"/></StackPanel></Grid>
    <DockPanel Grid.Row="3"><ComboBox x:Name="GroupBox" Width="145"/><ComboBox x:Name="DeviceBox" Width="180"/><TextBox x:Name="MetricSearch" ToolTip="搜索名称、原名、设备或指标 ID"/></DockPanel>
    <DataGrid x:Name="MetricGrid" Grid.Row="4"><DataGrid.Columns><DataGridTextColumn Header="选择显示指标" Binding="{Binding Name}" Width="2*" MinWidth="190"/><DataGridTextColumn Header="设备" Binding="{Binding Device}" Width="*" MinWidth="150"/><DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="80"/><DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="55"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100"/></DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Header="网络"><Grid Margin="14" TextElement.Foreground="#E1EBEF"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="选择监测网卡" FontSize="18"/><ComboBox x:Name="NetworkBox" Grid.Row="1" DisplayMemberPath="Name" SelectedValuePath="Id" HorizontalAlignment="Left" Width="420"/>
    <StackPanel Grid.Row="2" Margin="0,6,0,14"><TextBlock Text="自动模式优先联网物理网卡，连接正常时保持选择；固定网卡断开后不会切换。" TextWrapping="Wrap"/><TextBlock Text="速度以字节/秒显示，按 1024 换算；链路速率为 Mbps。VPN / 虚拟网卡可手动选择。" TextWrapping="Wrap"/><TextBlock x:Name="NetworkSummary" Foreground="#8FE3DD" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
    <DataGrid x:Name="NetworkGrid" Grid.Row="3"><DataGrid.Columns><DataGridTextColumn Header="网卡" Binding="{Binding Name}" Width="2*" MinWidth="190"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="95"/><DataGridTextColumn Header="连接" Binding="{Binding Connection}" Width="80"/><DataGridTextColumn Header="链路" Binding="{Binding Link}" Width="170"/><DataGridTextColumn Header="下载" Binding="{Binding DownText}" Width="95"/><DataGridTextColumn Header="上传" Binding="{Binding UpText}" Width="95"/></DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Header="传感器状态"><Grid Margin="12" TextElement.Foreground="#E1EBEF"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="110"/><RowDefinition/><RowDefinition Height="100"/></Grid.RowDefinitions>
    <WrapPanel><Button x:Name="AdminButton" Content="以管理员重启"/><Button x:Name="LogButton" Content="打开日志目录"/><Button x:Name="ExportButton" Content="导出诊断…"/></WrapPanel>
    <DockPanel Grid.Row="1"><CheckBox x:Name="OnlyErrors" Content="只看异常"/><CheckBox x:Name="OnlyUsed" Content="已用于显示"/><TextBox x:Name="StatusSearch" ToolTip="搜索传感器和设备"/></DockPanel>
    <DataGrid x:Name="DeviceGrid" Grid.Row="2" Margin="0,0,0,8"><DataGrid.Columns><DataGridTextColumn Header="已识别设备（包括无传感器设备）" Binding="{Binding Name}" Width="2*" MinWidth="190"/><DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="3*" MinWidth="240"/></DataGrid.Columns></DataGrid>
    <DataGrid x:Name="StatusGrid" Grid.Row="3"><DataGrid.Columns><DataGridTextColumn Header="指标" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="设备" Binding="{Binding Device}" Width="140"/><DataGridTextColumn Header="数值" Binding="{Binding ValueWithUnit}" Width="100"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="150"/><DataGridTextColumn Header="最后成功读取" Binding="{Binding LastSuccess}" Width="150"/><DataGridTextColumn Header="最后尝试" Binding="{Binding LastAttempt}" Width="150"/></DataGrid.Columns></DataGrid>
    <TextBox x:Name="DetailText" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </Grid></TabItem>
  </TabControl>
  <TextBlock x:Name="SaveStatus" Grid.Row="3" TextWrapping="Wrap" Foreground="#A6C2CD" Margin="0,9,0,0" Text="已保存 · 每秒更新；所有数据来自后台采集"/>
 </Grid>
 </ScrollViewer>
</Window>
