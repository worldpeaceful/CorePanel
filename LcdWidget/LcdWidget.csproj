<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>LcdWidget</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.6.0</Version>
    <Title>机核仪表</Title>
    <AssemblyTitle>机核仪表</AssemblyTitle>
    <Product>机核仪表</Product>
    <Description>机核仪表 · 桌面硬件监测</Description>
    <ApplicationIcon>Assets/CorePanel.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- WPF owns the DPI manifest; WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/CorePanel.ico" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre737" />
    <Resource Include="Assets/Skins/red.png" />
    <Resource Include="Assets/Skins/blue.png" />
    <Resource Include="Assets/Skins/purple.png" />
    <Resource Include="Assets/Skins/pink.png" />
  </ItemGroup>
</Project>
